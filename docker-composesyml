version: "3.8"

services:
  teams:
    build: .
    ports:
      - "8008:8008"
    volumes:
      - teams_uploads:/app/app/uploads
      - teams_db:/app
    environment:
      - SECRET_KEY=${SECRET_KEY:-teams-change-me-in-production}
      - UPLOAD_DIR=app/uploads
    restart: unless-stopped

volumes:
  teams_uploads:
  teams_db:
