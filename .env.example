# ---------------------------------------------------------------- App
APP_NAME=Teams
APP_URL=https://teams.collab.name.ng
# openssl rand -hex 32  (must match Collab Accounts' SECRET_KEY when AUTH_MODE=accounts)
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---------------------------------------------------------------- Auth
# accounts = Collab Accounts SSO (production). local = demo/dev email-only sign-in.
AUTH_MODE=accounts
ACCOUNTS_URL=https://accounts.collab.name.ng
ACCOUNTS_ME_CACHE_SECONDS=60
COOKIE_DOMAIN=.collab.name.ng
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
CORS_ORIGINS=

# ---------------------------------------------------------------- Database
# Either a full URL...
DATABASE_URL=
# ...or the parts (used when DATABASE_URL is blank)
POSTGRES_USER=teams
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=teams
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_POOL_MIN=1
DB_POOL_MAX=6

# ---------------------------------------------------------------- Storage
DATA_DIR=/app/data
# local = files under DATA_DIR/storage (mount a volume). s3 = any S3-compatible bucket.
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional public/CDN base for thumbnails & avatars (otherwise served through the app)
S3_PUBLIC_BASE_URL=
CACHE_DIR=/tmp/teams-cache
MAX_UPLOAD_MB=50
# Background preview workers (LibreOffice is memory hungry; 1 is right for a small VPS)
WORKER_THREADS=1
THUMBNAILS=true

# ---------------------------------------------------------------- Optional AI (OpenAI-compatible)
AI_PRIMARY_BASE_URL=
AI_PRIMARY_API_KEY=
AI_PRIMARY_MODEL=
AI_SECONDARY_BASE_URL=
AI_SECONDARY_API_KEY=
AI_SECONDARY_MODEL=
AI_TIMEOUT_SECONDS=45
AI_AUTO_TAG=true

# ---------------------------------------------------------------- Moderation
# comma-separated usernames who can moderate reports and verify orgs
ADMIN_USERNAMES=
# org slugs always shown with the verified badge
VERIFIED_ORGS=
REPORT_AUTOHIDE_THRESHOLD=5

# ---------------------------------------------------------------- Compose-only
APP_MEM_LIMIT=1g
DB_MEM_LIMIT=512m

# Collab Suite org sync (Crede <-> Teams): same long random value on both apps. Blank disables /api/suite/*
SUITE_SYNC_TOKEN=
